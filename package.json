{
  "name": "ashwani-portfolio",
  "version": "1.0.0",
  "description": "Interactive 3D portfolio - fly a UFO around my work (three.js + cannon-es)",
  "scripts": {
    "build": "rollup -c rollup_config.js",
    "watch": "rollup -c rollup_config.js -w",
    "island": "rollup -c experiments/island/rollup.config.js",
    "island:watch": "rollup -c experiments/island/rollup.config.js -w",
    "foam": "rollup -c experiments/foam/rollup.config.js",
    "foam:watch": "rollup -c experiments/foam/rollup.config.js -w",
    "river": "rollup -c experiments/river/rollup.config.js",
    "river:watch": "rollup -c experiments/river/rollup.config.js -w",
    "riverbank": "rollup -c experiments/riverbank/rollup.config.js",
    "riverbank:watch": "rollup -c experiments/riverbank/rollup.config.js -w",
    "riverbank-gallery": "rollup -c experiments/riverbank-gallery/rollup.config.js",
    "riverbank-gallery:watch": "rollup -c experiments/riverbank-gallery/rollup.config.js -w",
    "riverbank-waves": "rollup -c experiments/riverbank-waves/rollup.config.js",
    "riverbank-waves:watch": "rollup -c experiments/riverbank-waves/rollup.config.js -w",
    "riverbank-new": "rollup -c experiments/riverbank-new/rollup.config.js",
    "riverbank-new:watch": "rollup -c experiments/riverbank-new/rollup.config.js -w",
    "start": "serve",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "author": "Ashwani Kumar",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "rollup": "^4.18.0",
    "serve": "^14.2.3"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.164.1"
  }
}
